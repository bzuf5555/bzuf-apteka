# Telegram Bot — BotFather dan olinadi
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Groq API (bepul) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas (bepul tier) — https://cloud.mongodb.com
# Cluster → Connect → Drivers → Python → URI ni nusxalang
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dorixona

# Render deploy uchun (production)
# Render dashboard → Settings → Custom Domain yoki onrender.com URL
WEBHOOK_HOST=https://your-app-name.onrender.com
WEBHOOK_SECRET=change_this_to_random_secret_string

# Bot sozlamalari
SEARCH_RADIUS_KM=5
MAX_RESULTS=10
RATE_LIMIT_PER_MINUTE=10
BOT_ENV=development
